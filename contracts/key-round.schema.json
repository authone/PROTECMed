{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "key-round",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "run_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "round_index": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "party_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "incoming_public_key_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outgoing_public_key_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "run_plan_sha256",
    "context_sha256",
    "round_index",
    "party_id",
    "incoming_public_key_sha256",
    "outgoing_public_key_sha256"
  ],
  "additionalProperties": false
}
